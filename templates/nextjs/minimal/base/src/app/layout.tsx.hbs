{{#if options.styling.includeTailwind}}import './globals.css'{{/if}}
{{#if (eq language "typescript")}}import type { Metadata } from 'next'{{/if}}
{{#if options.dataFetching.includeTanStackQuery}}
import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
import { useState } from 'react'
{{/if}}

{{#if (eq language "typescript")}}
export const metadata: Metadata = {
  title: '{{projectName}}',
  description: 'Generated by CLI Scaffolding Tool',
}
{{/if}}

export default function RootLayout({
  children,
}{{#if (eq language "typescript")}}: {
  children: React.ReactNode
}{{/if}}) {
{{#if options.dataFetching.includeTanStackQuery}}
  const [queryClient] = useState(() => new QueryClient())

  return (
    <html lang="en">
      <body>
        <QueryClientProvider client={queryClient}>
          {children}
        </QueryClientProvider>
      </body>
    </html>
  )
{{else}}
  return (
    <html lang="en">
      <body>{children}</body>
    </html>
  )
{{/if}}
}