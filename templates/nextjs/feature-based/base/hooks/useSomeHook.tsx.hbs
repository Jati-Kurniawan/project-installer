import { useState, useEffect, useCallback } from 'react';

interface UseSomeHookOptions {
  initialValue?: string;
  autoFetch?: boolean;
}

interface UseSomeHookReturn {
  data: string | null;
  loading: boolean;
  error: string | null;
  refetch: () => void;
  updateData: (newData: string) => void;
}

export function useSomeHook(options: UseSomeHookOptions = {}): UseSomeHookReturn {
  const { initialValue = null, autoFetch = true } = options;
  
  const [data, setData] = useState<string | null>(initialValue);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  
  const fetchData = useCallback(async () => {
    setLoading(true);
    setError(null);
    
    try {
      // Simulate API call
      await new Promise(resolve => setTimeout(resolve, 1000));
      
      // Replace this with your actual data fetching logic
      const result = `Fetched data at ${new Date().toISOString()}`;
      setData(result);
    } catch (err) {
      setError(err instanceof Error ? err.message : 'An error occurred');
    } finally {
      setLoading(false);
    }
  }, []);
  
  const updateData = useCallback((newData: string) => {
    setData(newData);
  }, []);
  
  useEffect(() => {
    if (autoFetch) {
      fetchData();
    }
  }, [autoFetch, fetchData]);
  
  return {
    data,
    loading,
    error,
    refetch: fetchData,
    updateData
  };
}

export default useSomeHook;