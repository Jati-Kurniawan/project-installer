'use server';

interface OrderItem {
  id: number;
  quantity: number;
  price: number;
}

export async function createOrder(items: OrderItem[]) {
  // Add your order creation logic here
  const total = items.reduce((sum, item) => sum + (item.price * item.quantity), 0);
  
  console.log('Creating order:', { items, total });
  
  // Return order confirmation
  return {
    id: Date.now(),
    items,
    total,
    status: 'pending'
  };
}

