{
  "name": "Feature-Based Next.js App",
  "description": "A feature-based Next.js application with organized architecture, perfect for medium to large projects",
  "framework": "nextjs",
  "type": "feature-based",
  "version": "1.0.0",
  "author": "CLI Scaffolding Tool",
  "supportedLanguages": ["typescript", "javascript"],
  "supportedOptions": {
    "styling": ["tailwind"],
    "stateManagement": ["zustand"],
    "dataFetching": ["tanstack-query"],
    "devTools": ["eslint", "prettier"]
  },
  "dependencies": {
    "base": {
      "next": "^14.0.0",
      "react": "^18.0.0",
      "react-dom": "^18.0.0"
    },
    "conditional": {
      "typescript": {
        "@types/node": "^20.0.0",
        "@types/react": "^18.0.0",
        "@types/react-dom": "^18.0.0",
        "typescript": "^5.0.0"
      },
      "tailwind": {
        "tailwindcss": "^3.3.0",
        "autoprefixer": "^10.4.16",
        "postcss": "^8.4.31"
      },
      "zustand": {
        "zustand": "^4.4.0"
      },
      "tanstack-query": {
        "@tanstack/react-query": "^5.0.0"
      },
      "eslint": {
        "eslint": "^8.0.0",
        "eslint-config-next": "^14.0.0"
      },
      "prettier": {
        "prettier": "^3.0.0"
      }
    }
  },
  "files": {
    "base": [
      "package.json.hbs",
      "next.config.js.hbs",
      "README.md.hbs",
      "__tests__/ComponentA.test.{{ext}}.hbs",
      "__tests__/ComponentB.test.{{ext}}.hbs", 
      "__tests__/ComponentC.test.{{ext}}.hbs",
      "actions/auth.{{ext}}.hbs",
      "actions/search.{{ext}}.hbs",
      "actions/order.{{ext}}.hbs",
      "app/someroute/page.{{ext}}.hbs",
      "app/api/apiroute/route.{{ext}}.hbs",
      "app/blog/[dynamicroute]/page.{{ext}}.hbs",
      "app/blog/loading.{{ext}}.hbs",
      "app/layout.{{ext}}.hbs",
      "app/page.{{ext}}.hbs",
      "app/not-found.{{ext}}.hbs",
      "app/globals.css",
      "components/ComponentA/index.{{ext}}.hbs",
      "components/Buttons/PrimaryButton/index.{{ext}}.hbs",
      "components/Buttons/SecondaryButton/index.{{ext}}.hbs",
      "containers/home-page/hero-section/index.{{ext}}.hbs",
      "containers/home-page/info-section/index.{{ext}}.hbs",
      "containers/blog-page/content-section/index.{{ext}}.hbs",
      "db/client.{{ext}}.hbs",
      "hooks/useSomeHook.{{ext}}.hbs",
      "libs/fonts.{{ext}}.hbs",
      "libs/utils.{{ext}}.hbs",
      "public/fonts/.gitkeep",
      "public/images/.gitkeep",
      "services/someHelperFunction.{{ext}}.hbs",
      "store/useLayoutStore.{{ext}}.hbs",
      "store/useUserStore.{{ext}}.hbs",
      "styles/global.css",
      "types/User.{{ext}}.hbs",
      "types/Blog.{{ext}}.hbs",
      "types/Product.{{ext}}.hbs",
      "types/Service.{{ext}}.hbs"
    ],
    "conditional": {
      "tanstack-query": [
        "components/providers/QueryProvider.{{ext}}.hbs"
      ],
      "zustand": [
        "store/useAppStore.{{ext}}.hbs"
      ],
      "typescript": [
        "tsconfig.json",
        "next-env.d.ts"
      ],
      "tailwind": [
        "tailwind.config.js",
        "postcss.config.js"
      ],
      "eslint": [
        ".eslintrc.json"
      ],
      "prettier": [
        ".prettierrc"
      ]
    }
  }
}