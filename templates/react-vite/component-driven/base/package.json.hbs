{
  "name": "{{projectName}}",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "{{#if (eq language "typescript")}}tsc && {{/if}}vite build",
    "lint": "{{#if options.devTools.includeESLint}}eslint . --ext {{#if (eq language "typescript")}}ts,tsx{{else}}js,jsx{{/if}} --report-unused-disable-directives --max-warnings 0{{else}}echo 'No linting configured'{{/if}}",
    "preview": "vite preview"{{#if options.devTools.includePrettier}},
    "format": "prettier --write ."{{/if}}
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.15.0"{{#if options.stateManagement.includeZustand}},
    "zustand": "^4.4.0"{{/if}}{{#if options.dataFetching.includeTanStackQuery}},
    "@tanstack/react-query": "^5.0.0"{{/if}}{{#if options.styling.includeTailwind}},
    "tailwindcss": "^3.3.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.31"{{/if}}
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.3",
    "vite": "^4.4.5"{{#if (eq language "typescript")}},{{/if}}{{#if options.devTools.includeESLint}},{{/if}}{{#if options.devTools.includePrettier}},{{/if}}
{{#if (eq language "typescript")}}
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "typescript": "^5.0.2"{{#if options.devTools.includeESLint}},{{/if}}{{#if options.devTools.includePrettier}},{{/if}}
{{/if}}
{{#if options.devTools.includeESLint}}
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3"{{#if options.devTools.includePrettier}},{{/if}}
{{/if}}
{{#if options.devTools.includePrettier}}
    "prettier": "^3.0.0"
{{/if}}
  }
}