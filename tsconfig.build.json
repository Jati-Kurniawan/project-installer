{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "sourceMap": false,
    "removeComments": true,
    "noEmitOnError": true
  },
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/__tests__/**/*",
    "**/*.test.ts",
    "**/*.spec.ts",
    "jest.config.js",
    "coverage/**/*",
    "dist/**/*"
  ]
}