{
  "name": "starter-cli",
  "version": "1.0.0",
  "description": "A CLI tool for scaffolding modern web development projects with Next.js and React + Vite templates",
  "main": "dist/lib/index.js",
  "bin": {
    "starter-cli": "./dist/bin/cli.js"
  },
  "files": [
    "dist/",
    "templates/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:prod": "npm run clean && tsc --project tsconfig.build.json",
    "dev": "tsc --watch",
    "start": "node dist/bin/cli.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build:prod && npm test",
    "postinstall": "node -e \"console.log('\\n🚀 Starter CLI installed successfully!\\n\\nGet started with: starter-cli init\\n')\""
  },
  "keywords": [
    "cli",
    "scaffolding",
    "nextjs",
    "react",
    "vite",
    "typescript",
    "template",
    "generator",
    "boilerplate",
    "starter"
  ],
  "author": "Starter CLI Team",
  "license": "MIT",
  "homepage": "https://github.com/starter-cli/starter-cli#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/starter-cli/starter-cli.git"
  },
  "bugs": {
    "url": "https://github.com/starter-cli/starter-cli/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "execa": "^8.0.1",
    "fs-extra": "^11.1.1",
    "handlebars": "^4.7.9",
    "inquirer": "^9.2.12",
    "joi": "^18.1.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/handlebars": "^4.0.40",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^30.0.0",
    "@types/joi": "^17.2.2",
    "@types/node": "^20.8.0",
    "fast-check": "^4.6.0",
    "jest": "^30.3.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.4.6",
    "typescript": "^5.2.2"
  }
}
