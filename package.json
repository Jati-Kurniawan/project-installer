{
  "name": "starter-cli",
  "version": "1.0.0",
  "description": "A CLI tool for scaffolding modern web development projects with Next.js and React + Vite templates",
  "main": "dist/lib/index.js",
  "bin": {
    "starter-cli": "./dist/bin/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/bin/cli.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rimraf dist"
  },
  "keywords": [
    "cli",
    "scaffolding",
    "nextjs",
    "react",
    "vite",
    "typescript",
    "template"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "fs-extra": "^11.1.1",
    "handlebars": "^4.7.9",
    "inquirer": "^9.2.12",
    "joi": "^18.1.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/handlebars": "^4.0.40",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^30.0.0",
    "@types/joi": "^17.2.2",
    "@types/node": "^20.8.0",
    "fast-check": "^4.6.0",
    "jest": "^30.3.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.4.6",
    "typescript": "^5.2.2"
  }
}
